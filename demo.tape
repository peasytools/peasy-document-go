# peasy-document-go — Markdown, HTML, CSV conversion (Go)
# Theme: Solarized Dark
# Generated for AgentGIF demo collection

Output demo.gif
Set Shell "zsh"
Set Theme "Builtin Solarized Dark"
Set Width 800
Set Height 500
Set FontSize 14
Set Padding 20
Set TypingSpeed 50ms

# Show package info
Type "# peasy-document-go — Markdown, HTML, CSV conversion for Go"
Enter
Type "# peasyformats.com"
Enter
Sleep 500ms

# Run the demo
Type "go run ./examples/demo/"
Enter
Sleep 5s
